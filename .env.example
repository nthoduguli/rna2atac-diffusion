# Copy to .env and fill in with your own cluster paths. .env is gitignored;
# conf/default.config.yaml intentionally omits these keys so they resolve here.
data__rna_path=/scratch/<user>/rna2atac-data/multiome/rna_pipeline_ready.h5ad
data__atac_path=/scratch/<user>/rna2atac-data/multiome/atac_pseudobulk.h5ad

peak_filter__reference_atac_path=/scratch/<user>/rna2atac-data/full/atac.h5ad
peak_filter__output_path=/scratch/<user>/rna2atac-data/full/atac_filtered_5pct_67type.h5ad

pseudobulk__query_atac_path=/scratch/<user>/rna2atac-data/multiome/multiome_atac.h5ad
pseudobulk__reference_atac_path=/scratch/<user>/rna2atac-data/full/atac_filtered_5pct_67type.h5ad
pseudobulk__output_path=/scratch/<user>/rna2atac-data/multiome/atac_pseudobulk.h5ad
pseudobulk__query_rna_path=/scratch/<user>/rna2atac-data/multiome/multiome_rna.h5ad
pseudobulk__rna_output_path=/scratch/<user>/rna2atac-data/multiome/rna_pipeline_ready.h5ad

checkpoints__output_dir=/scratch/<user>/rna2atac-data/checkpoints
checkpoints__scvi_dir=/scratch/<user>/rna2atac-data/checkpoints/scvi
checkpoints__peakvi_dir=/scratch/<user>/rna2atac-data/checkpoints/peakvi
checkpoints__diffusion_path=/scratch/<user>/rna2atac-data/checkpoints/diffusion.pt
checkpoints__mlp_baseline_path=/scratch/<user>/rna2atac-data/checkpoints/mlp_baseline.pt
checkpoints__mean_baseline_path=/scratch/<user>/rna2atac-data/checkpoints/celltype_mean_baseline.npz

figures__output_dir=/scratch/<user>/rna2atac-data/figures

sample__output_rna_path=/scratch/<user>/rna2atac-data/multiome/rna_sample.h5ad
sample__output_atac_path=/scratch/<user>/rna2atac-data/multiome/atac_sample.h5ad
